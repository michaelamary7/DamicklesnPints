    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "nodemon": "^3.1.3",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
